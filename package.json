{
  "name": "agent-canvas",
  "version": "0.1.0",
  "description": "A malleable canvas built live by a coding agent",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && HOST=${HOST:-0.0.0.0} PORT=${PORT:-5317} tsx src/server/index.ts",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "e2e": "tsx scripts/e2e.ts",
    "serve": "HOST=${HOST:-0.0.0.0} PORT=${PORT:-5317} tsx src/server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "d3": "^7.9.0",
    "linkedom": "^0.18.13",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

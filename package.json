{
  "name": "caddis",
  "version": "0.2.0",
  "private": true,
  "description": "A malleable canvas built live by a coding agent",
  "homepage": "https://github.com/mcreenan/caddis",
  "license": "ISC",
  "author": "Matt Creenan <mattcreenan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcreenan/caddis.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "vp build && node scripts/electron.mjs",
    "electron": "node scripts/electron.mjs",
    "web": "vp build && vp pack && node out/server/index.mjs",
    "serve": "node out/server/index.mjs",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run",
    "e2e": "vp build && npm run e2e:only",
    "e2e:only": "CADDIS_E2E=1 vp test run --project e2e",
    "dist": "vp build && electron-builder --publish never",
    "dist:linux": "vp build && electron-builder --linux --publish never",
    "dist:mac": "vp build && electron-builder --mac --publish never",
    "prepare": "vp config"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "d3": "^7.9.0",
    "idiomorph": "^0.8.0",
    "linkedom": "^0.18.13",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plus": "1.2.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "productName": "Caddis"
}

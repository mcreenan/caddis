{
  "name": "agent-canvas",
  "version": "0.2.0",
  "description": "A malleable canvas built live by a coding agent",
  "scripts": {
    "dev": "node scripts/with-display.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && npm run electron",
    "electron": "node scripts/with-display.mjs electron .",
    "web": "electron-vite build && npm run serve",
    "serve": "HOST=${HOST:-0.0.0.0} PORT=${PORT:-5317} tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "d3": "^7.9.0",
    "idiomorph": "^0.8.0",
    "linkedom": "^0.18.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.1",
    "electron-vite": "^6.0.0-beta.8",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "out/main/index.js"
}
